namespace isotime.storage;

enum CompressionType : byte { None = 0, DeltaDelta = 1, BitPackedDelta = 2 }

table RawValue {
  data: [ubyte];
  compression: CompressionType = None;
}

table RefValue {
  offset: uint32;
}

table HashValue {
  hash: [ubyte];
}

union ValueType { RawValue, RefValue, HashValue }

table VectorClockEntry {
  node_id: uint32;
  counter: uint64;
}

table VectorClock {
  entries: [VectorClockEntry];
}

table Entry {
  key: [ubyte];
  value: ValueType;
  clock: VectorClock;
}

table TagKey {
  key: [ubyte];
}

table TagIndex {
  tag: string;
  keys: [TagKey];
}

table SSTableData {
  entries: [Entry];
  bloom_filter: [ubyte];
  num_hashes: uint32;
  tag_indexes: [TagIndex];
}

root_type SSTableData;
